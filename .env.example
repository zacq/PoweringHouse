# --- Seed of Power articles (Beehiiv) ---
# If unset, /blog and the home page's recent letters show their empty state.
BEEHIIV_API_KEY=""
BEEHIIV_PUBLICATION_ID=""

# --- Airtable (form submissions + Events / Ventures / E-Resources content) ---
# Personal access token scoped to this base only, with data.records:read and data.records:write.
AIRTABLE_TOKEN=""
# Starts with "app", from the base's URL.
AIRTABLE_BASE_ID=""
