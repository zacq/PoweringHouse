# --- Database (Neon Postgres) ---
# Pooled connection string, used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/powering_house?sslmode=require"
# Direct (non-pooled) connection string, used only for running migrations.
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/powering_house?sslmode=require"
# If you provisioned the database through Netlify's "Neon" extension instead
# of neon.tech directly, it sets NETLIFY_DATABASE_URL / NETLIFY_DATABASE_URL_UNPOOLED
# on its own — `npm run build` maps those to DATABASE_URL/DIRECT_URL automatically,
# so you don't need to set these two by hand on Netlify.

# --- Auth (single admin, NextAuth Credentials provider) ---
# Random secret used to sign session tokens. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
# Local dev: http://localhost:3000  |  Production: https://your-domain.example
NEXTAUTH_URL="http://localhost:3000"
# The admin login email.
ADMIN_EMAIL="you@example.com"
# bcrypt hash of the admin password. Generate with: npm run hash:password -- "your-password"
ADMIN_PASSWORD_HASH="$2a$10$replace-with-a-real-bcrypt-hash"

# --- Newsletter sending (optional) ---
# If unset, the "Notify subscribers" admin feature stays hidden/disabled and only
# email capture + the admin subscriber list/export still work.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Powering House <hello@example.com>"
